# =========================================================================
# Atlas Insights monorepo — example environment file
# Copy to `.env` at the workspace root. Workspace tools read root .env.
# App-scoped vars also live in apps/<name>/.env when needed.
# =========================================================================

# ---- Web app (Vite — only VITE_ prefixed vars are bundled to the client) ----
VITE_API_BASE_URL=/api
VITE_USE_DIRECT_FEED=false
VITE_USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_month.csv
VITE_QUERY_STALE_MS=300000

# ---- API (NestJS) ----
API_PORT=3000
API_HOST=0.0.0.0
# Comma-separated list of allowed CORS origins. Tightened in production.
API_CORS_ORIGINS=http://localhost:5173
# Upstream feed URL the API proxies + caches.
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_month.csv
# Cache TTL in seconds for the parsed earthquake payload.
CACHE_TTL_SECONDS=300
# Throttler: max requests per IP per window.
THROTTLE_LIMIT=60
THROTTLE_WINDOW_SECONDS=60
# `info`, `warn`, `error`, or `debug`.
LOG_LEVEL=info

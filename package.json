{
  "name": "atlas-insights",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas Insights — Nx monorepo with a React dashboard (apps/web) and a NestJS caching/security API (apps/api).",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm run -w apps/web dev",
    "dev:api": "npm run -w apps/api start:dev",
    "build": "npm-run-all --serial build:libs build:api build:web",
    "build:libs": "echo \"libs are type-only / consumed via tsconfig paths — nothing to compile\"",
    "build:web": "npm run -w apps/web build",
    "build:api": "npm run -w apps/api build",
    "start:api": "npm run -w apps/api start:prod",
    "preview:web": "npm run -w apps/web preview",
    "lint": "npm-run-all --parallel lint:web lint:api",
    "lint:web": "npm run -w apps/web lint",
    "lint:api": "npm run -w apps/api lint",
    "typecheck": "npm-run-all --parallel typecheck:web typecheck:api",
    "typecheck:web": "npm run -w apps/web typecheck",
    "typecheck:api": "npm run -w apps/api typecheck",
    "format": "prettier --write \"{apps,libs}/**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.{ts,tsx,css,md,json}\"",
    "nx": "nx",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "npm-run-all": "^4.1.5",
    "nx": "^19.8.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}

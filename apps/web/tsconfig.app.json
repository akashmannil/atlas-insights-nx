{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@atlas/shared-types": ["../../libs/shared-types/src/index.ts"],
      "@atlas/shared-utils": ["../../libs/shared-utils/src/index.ts"]
    }
  },
  "include": ["src", "../../libs/shared-types/src", "../../libs/shared-utils/src"],
  "exclude": ["node_modules", "dist"]
}
